  "components": [
    {
      "name": "Landing Primary Button",
      "kind": "button",
      "refersTo": "button-landing-primary",
      "description": "Night-side primary action: quiet white pill on navy.",
      "html": "<div class=\"ds-night\"><button class=\"ds-btn-night-primary\">Enter the Workbench</button></div>",
      "css": ".ds-night{background:#020e21;padding:24px;display:inline-block}.ds-btn-night-primary{min-height:50px;padding:0 2rem;border:1px solid transparent;border-radius:999px;background:#eef6fb;color:#031226;font:600 1rem Inter,'Segoe UI',system-ui,sans-serif;cursor:pointer;transition:background 200ms cubic-bezier(0.2,0.8,0.2,1),transform 120ms}.ds-btn-night-primary:hover{background:#fff}.ds-btn-night-primary:active{transform:scale(0.98)}.ds-btn-night-primary:focus-visible{outline:3px solid #7cc4ff;outline-offset:3px}"
    },
    {
      "name": "Landing Ghost Button",
      "kind": "button",
      "refersTo": "button-landing-ghost",
      "description": "Night-side secondary action.",
      "html": "<div class=\"ds-night\"><button class=\"ds-btn-night-ghost\">See how it works</button></div>",
      "css": ".ds-night{background:#020e21;padding:24px;display:inline-block}.ds-btn-night-ghost{min-height:50px;padding:0 2rem;border:1px solid rgba(255,255,255,0.22);border-radius:999px;background:transparent;color:#e6eef7;font:600 1rem Inter,'Segoe UI',system-ui,sans-serif;cursor:pointer;transition:border-color 200ms cubic-bezier(0.2,0.8,0.2,1)}.ds-btn-night-ghost:hover{border-color:rgba(255,255,255,0.5)}.ds-btn-night-ghost:focus-visible{outline:3px solid #7cc4ff;outline-offset:3px}"
    },
    {
      "name": "Workbench Primary Button",
      "kind": "button",
      "refersTo": "button-workbench-primary",
      "description": "The one day-side action colour.",
      "html": "<button class=\"ds-btn-primary\">Approve draft</button>",
      "css": ".ds-btn-primary{min-height:40px;padding:0 1rem;border:1px solid transparent;border-radius:10px;background:#1d63d6;color:#fff;font:600 0.875rem Inter,'Segoe UI',system-ui,sans-serif;cursor:pointer;transition:background 200ms cubic-bezier(0.2,0.8,0.2,1),transform 120ms}.ds-btn-primary:hover{background:color-mix(in srgb,#1d63d6 86%,#0b1a2e)}.ds-btn-primary:active{transform:scale(0.98)}.ds-btn-primary:focus-visible{outline:3px solid #1d63d6;outline-offset:3px}"
    },
    {
      "name": "Workbench Danger Button",
      "kind": "button",
      "refersTo": "button-danger",
      "description": "Reject and destructive decisions.",
      "html": "<button class=\"ds-btn-danger\">Reject</button>",
      "css": ".ds-btn-danger{min-height:44px;min-width:150px;padding:0 1rem;border:1px solid color-mix(in srgb,#b3261e 45%,transparent);border-radius:10px;background:#fff;color:#b3261e;font:600 0.875rem Inter,'Segoe UI',system-ui,sans-serif;cursor:pointer;transition:background 200ms,border-color 200ms}.ds-btn-danger:hover{border-color:#b3261e;background:color-mix(in srgb,#b3261e 6%,#fff)}.ds-btn-danger:focus-visible{outline:3px solid #1d63d6;outline-offset:3px}"
    },
    {
      "name": "Workbench Input",
      "kind": "input",
      "refersTo": "input-workbench",
      "description": "Labelled field on the light register.",
      "html": "<label class=\"ds-label\">Asset tag<input class=\"ds-input\" placeholder=\"P-204\"></label>",
      "css": ".ds-label{display:grid;gap:0.5rem;color:#3f5570;font:600 0.875rem Inter,'Segoe UI',system-ui,sans-serif}.ds-input{min-height:42px;padding:0.5rem 0.75rem;border:1px solid rgba(20,45,80,0.3);border-radius:10px;background:#fff;color:#0b1a2e;font:400 1rem Inter,'Segoe UI',system-ui,sans-serif}.ds-input:focus-visible{outline:3px solid #1d63d6;outline-offset:3px}.ds-input[aria-invalid=true]{border-color:#b3261e}"
