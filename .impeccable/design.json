      "css": ".ds-night-block{background:#041329;padding:24px}.ds-input-auth{width:100%;min-height:46px;padding:0.5rem 0.75rem;border:1px solid rgba(160,200,240,0.18);border-radius:12px;background:rgba(1,8,20,0.6);color:#e8eff8;font:400 1rem Inter,'Segoe UI',system-ui,sans-serif;transition:border-color 200ms,box-shadow 200ms}.ds-input-auth:hover{border-color:rgba(160,200,240,0.32)}.ds-input-auth:focus-visible{outline:none;border-color:#5ad8e8;box-shadow:0 0 0 4px rgba(53,215,232,0.18)}"
    },
    {
      "name": "Sidebar Navigation",
      "kind": "nav",
      "refersTo": "nav-link-active",
      "description": "Grouped workbench nav with a blue-washed active item.",
      "html": "<nav class=\"ds-nav\"><p class=\"ds-nav-label\">Govern</p><a class=\"ds-nav-link ds-active\" href=\"#\">Approvals</a><a class=\"ds-nav-link\" href=\"#\">Executions</a><a class=\"ds-nav-link\" href=\"#\">Audit</a></nav>",
      "css": ".ds-nav{display:grid;gap:2px;width:232px;padding:16px;background:#fff;font-family:Inter,'Segoe UI',system-ui,sans-serif}.ds-nav-label{margin:0 12px 8px;color:#5d7089;font-size:0.75rem;font-weight:700;letter-spacing:0.12em;text-transform:uppercase}.ds-nav-link{padding:0.5rem 0.75rem;border-radius:10px;color:#3f5570;font-size:0.875rem;font-weight:600;text-decoration:none}.ds-nav-link:hover{background:#f4f7fb;color:#0b1a2e}.ds-nav-link.ds-active{background:color-mix(in srgb,#1d63d6 10%,#fff);color:#1d63d6;font-weight:700}.ds-nav-link:focus-visible{outline:3px solid #1d63d6;outline-offset:3px}"
    },
    {
      "name": "Status Chips",
      "kind": "chip",
      "refersTo": "chip-status-ok",
      "description": "One meaning per colour: verified, needs review, error.",
      "html": "<span class=\"ds-chip ds-ok\">Chain verified</span> <span class=\"ds-chip ds-warn\">Awaiting review</span> <span class=\"ds-chip ds-bad\">Rejected</span>",
      "css": ".ds-chip{display:inline-flex;align-items:center;gap:6px;padding:4px 10px;border-radius:999px;background:#e6edf6;color:#3f5570;font:700 0.75rem Inter,'Segoe UI',system-ui,sans-serif}.ds-chip::before{content:'';width:7px;height:7px;border-radius:50%;background:currentColor}.ds-ok{background:color-mix(in srgb,#1c7c48 11%,#fff);color:#1c7c48}.ds-warn{background:color-mix(in srgb,#9a5b00 12%,#fff);color:#9a5b00}.ds-bad{background:color-mix(in srgb,#b3261e 10%,#fff);color:#b3261e}"
    },
    {
      "name": "Dashboard Card",
      "kind": "card",
      "refersTo": "card-workbench",
      "description": "White work surface on the off-white field; rests flat, lifts on hover.",
      "html": "<div class=\"ds-field\"><article class=\"ds-card\"><header><h3>Review queue</h3><a href=\"#\">Open desk</a></header><p><b>1</b> draft awaits human review</p></article></div>",
      "css": ".ds-field{background:#f3f5f8;padding:24px}.ds-card{display:grid;gap:0.75rem;padding:1.5rem;border:1px solid rgba(20,45,80,0.14);border-radius:16px;background:#fff;color:#0b1a2e;box-shadow:0 1px 2px rgba(15,35,65,0.06);font-family:Inter,'Segoe UI',system-ui,sans-serif;transition:box-shadow 400ms cubic-bezier(0.16,1,0.3,1)}.ds-card:hover{box-shadow:0 8px 24px rgba(15,35,65,0.08)}.ds-card header{display:flex;justify-content:space-between;align-items:baseline}.ds-card h3{margin:0;font-size:1.125rem}.ds-card a{color:#1d63d6;font-size:0.875rem;font-weight:600;text-decoration:none}.ds-card a:focus-visible{outline:3px solid #1d63d6;outline-offset:3px}.ds-card p{margin:0;color:#3f5570}.ds-card b{margin-right:4px;color:#0b1a2e;font-size:1.75rem;font-variant-numeric:tabular-nums}"
    },
    {
      "name": "Signals Strip",
      "kind": "custom",
      "refersTo": "card-workbench",
      "description": "One sentence of live system status, not a wall of tiles.",
      "html": "<ul class=\"ds-signals\"><li><i class=\"ds-dot\"></i><span>Backend</span><b>Connected</b></li><li><i class=\"ds-dot\"></i><span>Hosted AI calls</span><b>0</b></li><li><i class=\"ds-dot ds-warn\"></i><span>Approvals</span><b>1 pending</b></li></ul>",
      "css": ".ds-signals{display:flex;margin:0;padding:8px;border:1px solid rgba(20,45,80,0.14);border-radius:16px;background:#fff;box-shadow:0 1px 2px rgba(15,35,65,0.06);list-style:none;font-family:Inter,'Segoe UI',system-ui,sans-serif}.ds-signals li{flex:1;display:grid;grid-template-columns:auto 1fr;column-gap:8px;padding:8px 12px}.ds-signals li+li{border-left:1px solid rgba(20,45,80,0.14)}.ds-dot{grid-row:1/3;align-self:center;width:9px;height:9px;border-radius:50%;background:#1c7c48;box-shadow:0 0 0 3px color-mix(in srgb,#1c7c48 18%,transparent)}.ds-dot.ds-warn{background:#9a5b00;box-shadow:none}.ds-signals span{color:#3f5570;font-size:0.75rem}.ds-signals b{color:#0b1a2e;font-weight:650;font-variant-numeric:tabular-nums}"
    },
    {
      "name": "P&ID Tag Bubble",
