# Upload only what the hosted demo needs: frontend source, backend app, the Vercel function and hosted report PDFs.
/*
!/frontend
!/backend
!/api
!/data
!/vercel.json
!/requirements.txt
!/.python-version
/frontend/node_modules
/frontend/dist
/backend/.venv
/backend/tests
/data/*
!/data/nwis-hosted
**/__pycache__
.env*
