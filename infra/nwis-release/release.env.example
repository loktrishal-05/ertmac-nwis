# Copy to a protected file OUTSIDE the upload directory. Do not commit filled secrets.
# Generate each secret separately, e.g. Python secrets.token_hex(32). Hex is URL-safe.
NWIS_DB_OWNER_PASSWORD=
NWIS_DB_PASSWORD=
NWIS_BACKEND_IMAGE=
NWIS_MODEL_DIR=
NWIS_PUBLIC_ORIGIN=https://sovereign-ai-workbench-nine.vercel.app
# Reserved TLS gateway; no trailing slash. Must be supplied before artifact preparation.
NWIS_GATEWAY_ORIGIN=
# Final release enables signup and email verification/password recovery. Missing required values fail preparation.
NWIS_SIGNUP_MODE=open
NWIS_AUTH_SECRET=
NWIS_SMTP_HOST=
NWIS_SMTP_PORT=587
NWIS_SMTP_TLS=starttls
NWIS_SMTP_SENDER=
# Required when the selected relay requires authentication (including Gmail).
NWIS_SMTP_USERNAME=
NWIS_SMTP_PASSWORD=
# Google is deliberately disabled in release Compose and blocked by the gateway.
