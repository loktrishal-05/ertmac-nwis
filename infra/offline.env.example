# Merge into root .env after configuring site-specific credentials and HTTPS origins.
# Application policy, NOT a network firewall. Linux backend + existing Compose services.
# With docker-compose.backend.yml, set BACKEND_DATABASE_URL in protected .env using
# the postgres service hostname and URL-encoded credentials for the intended account.
WORKBENCH_DEPLOYMENT_MODE=confidential
WORKBENCH_GOVERNMENT_RESOURCES_ENABLED=false
WORKBENCH_BHASHINI_ENABLED=false
MODEL_RUNTIME=ollama
MODEL_BASE_URL=http://127.0.0.1:11434
MODEL_NAME=qwen3.5:9b
PRIMARY_MODEL=qwen3.5:9b
FAST_MODEL=qwen3.5:4b
MODEL_LOG_PROMPTS=false
SESSION_COOKIE_SECURE=true
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
HF_HUB_DISABLE_TELEMETRY=1
DO_NOT_TRACK=1
OLLAMA_NO_CLOUD=1
LANGCHAIN_TRACING_V2=false
LANGSMITH_TRACING=false
# Optional D-LIVE: preserve existing loopback values when merging this overlay.
# Once provisioned, set STT to http://127.0.0.1:8765/stt and TTS to http://127.0.0.1:8765/tts.
# See docs/local_voice_and_language_resources.md; no hosted fallback.
WORKBENCH_STT_URL=
WORKBENCH_TTS_URL=
