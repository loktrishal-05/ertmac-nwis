# Copy to infra/.env (untracked) and fill in. docker compose -f infra/docker-compose.nwis.yml reads it automatically.
# Never commit real secrets. Restart the backend after changes:
#   docker compose -f infra/docker-compose.nwis.yml up -d backend mailpit

# Required for email OTP (verification, password recovery) and Google sign-in. 32+ random characters, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
NWIS_AUTH_SECRET=

# open = new accounts can sign in immediately (development); approval = an administrator approves each account.
NWIS_SIGNUP_MODE=open

# --- Email delivery -------------------------------------------------------------------------------------------
# Default (all empty): the local Mailpit catcher. Codes are visible at http://127.0.0.1:8025 and never leave the machine.
# To deliver to real inboxes, use your provider's SMTP. Gmail example (needs 2-step verification + an App Password):
#   NWIS_SMTP_HOST=smtp.gmail.com
#   NWIS_SMTP_PORT=587
#   NWIS_SMTP_TLS=starttls
#   NWIS_SMTP_USERNAME=you@gmail.com
#   NWIS_SMTP_PASSWORD=<16-character app password>
#   NWIS_SMTP_SENDER=eRTMAC-NWIS <you@gmail.com>
NWIS_SMTP_HOST=
NWIS_SMTP_PORT=
NWIS_SMTP_TLS=
NWIS_SMTP_USERNAME=
NWIS_SMTP_PASSWORD=
NWIS_SMTP_SENDER=

# --- Google sign-in (OpenID Connect) --------------------------------------------------------------------------
# Google Cloud Console → APIs & Services → Credentials → Create OAuth client ID → Web application.
#   Authorized JavaScript origin:  http://localhost:3000
#   Authorized redirect URI:       http://localhost:3000/api/auth/google/callback
# Open the app at http://localhost:3000 (not 127.0.0.1) so the origin matches. In production use your https origin.
NWIS_GOOGLE_ENABLED=false
NWIS_GOOGLE_CLIENT_ID=
NWIS_GOOGLE_CLIENT_SECRET=
NWIS_GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback
NWIS_AUTH_FRONTEND_ORIGIN=http://localhost:3000
