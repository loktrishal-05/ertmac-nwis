# Copy this file to .env at the repository root. Never commit secrets.
# List values must use JSON syntax. Environment variables override .env values.
WORKBENCH_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://127.0.0.1:3000"]
# Local development defaults only; replace for deployment. Never commit real credentials.
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/sovereign_workbench
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=knowledge_chunks_v1
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
EMBEDDING_DIMENSION=768
CHUNK_TARGET_TOKENS=400
CHUNK_MAX_TOKENS=500
CHUNK_OVERLAP_TOKENS=60
PID_RENDER_DPI=300
SPARSE_RETRIEVAL_ENABLED=true
DENSE_TOP_K=30
SPARSE_TOP_K=30
HYBRID_FUSION=rrf
RERANKING_ENABLED=true
RERANKER_MODEL=BAAI/bge-reranker-base
RERANK_TOP_K=20
FINAL_CONTEXT_K=6
STRUCTURED_CSV_MAX_BYTES=10485760
STRUCTURED_CSV_MAX_ROWS=50000
STRUCTURED_QUERY_MAX_LIMIT=2000
# Local model gateway (Phase 4A). Development runtime is Ollama; vLLM is a
# registered-but-unimplemented placeholder. No hosted inference is ever permitted.
MODEL_RUNTIME=ollama
MODEL_BASE_URL=http://127.0.0.1:11434
# Install explicitly with `ollama pull qwen3.5:9b`; verify with `ollama list`.
MODEL_NAME=qwen3.5:9b
# Production routing profiles; MODEL_NAME remains the explicit standalone gateway setting.
FAST_MODEL=qwen3.5:4b
PRIMARY_MODEL=qwen3.5:9b
MODEL_ALLOWED_HOSTS=127.0.0.1,localhost,::1,ollama,vllm,model-runtime
# For LAN inference, set MODEL_BASE_URL and add its exact RFC1918 IP or
# .internal/.local hostname here. Public endpoints cannot be allowlisted.
# Data/OCR/manifests and model artifacts stay on the backend host filesystem.
# WORKBENCH_DATA_ROOT=C:/workbench/data
# WORKBENCH_MODEL_ROOT=C:/workbench/models
MODEL_CONNECT_TIMEOUT_SECONDS=5
MODEL_TIMEOUT_SECONDS=120
# First call after startup includes model load (minutes for a 9B on CPU).
MODEL_FIRST_LOAD_TIMEOUT_SECONDS=600
MODEL_MAX_RETRIES=2
MODEL_TEMPERATURE=0.0
MODEL_SEED=42
MODEL_CONTEXT_WINDOW=8192
MODEL_MAX_OUTPUT_TOKENS=1024
MODEL_KEEP_ALIVE=30m
MODEL_STRUCTURED_REPAIR_ATTEMPTS=1
# false (default): logs never contain prompt bodies, only counts/roles/timings.
MODEL_LOG_PROMPTS=false
# Existing LangGraph agent orchestration; Phase 7 adds no agents.
AGENT_ROUTER_MIN_CONFIDENCE=0.5
AGENT_TOOL_MAX_WINDOW_DAYS=90
AGENT_MAX_STEPS=12
AGENT_TRACE_ENABLED=true
# false disables only query-text storage in agent_runs; step/route/timing
# tracing is unaffected. See AGENT_TRACE_ENABLED to disable tracing entirely.
AGENT_TRACE_STORE_QUERY=true
AGENT_RUN_TIMEOUT_SECONDS=300
# Knowledge agent (Phase 4C). Uncalibrated provisional default -- Phase 3B2
# found no calibrated rejection threshold. See docs/phase4-decisions.md D-009.
KNOWLEDGE_RELEVANCE_FLOOR=0.0

# Advanced-C: optional local HTTP adapter endpoints. Empty keeps text mode.
WORKBENCH_STT_URL=
WORKBENCH_TTS_URL=
WORKBENCH_SPEECH_TIMEOUT_SECONDS=30
# Word confidence below this flags a technical identifier for correction.
WORKBENCH_STT_IDENTIFIER_MIN_CONFIDENCE=0.85
# PUBLIC_EXTERNAL_OPTIONAL; never used for confidential data. No external client ships in this build.
WORKBENCH_BHASHINI_ENABLED=false
# Optional path to an operator-reviewed language resource registry (JSON list).
WORKBENCH_LANGUAGE_RESOURCE_REGISTRY=
# Optional summary-only n8n integration. Supply a random secret of >=32 characters.
WORKBENCH_AUTOMATION_SECRET=
# Existing reviewer/admin UUID, rechecked per webhook; never sent to n8n.
WORKBENCH_AUTOMATION_USER_ID=

# Phase E. Public connectors require a separate public deployment and reviewed registry.
WORKBENCH_DEPLOYMENT_MODE=development
WORKBENCH_GOVERNMENT_RESOURCES_ENABLED=false
WORKBENCH_GOVERNMENT_RESOURCE_REGISTRY=
WORKBENCH_RELEASE_MIN_FREE_GIB=10
WORKBENCH_RELEASE_MODEL_DIGESTS={}
# Offline/production overlay and installation steps: docs/offline_deployment_and_release.md

# Phase F accounts. See docs/phase_f_authentication.md. Connected services are optional.
WORKBENCH_SIGNUP_MODE=approval
# Generate a protected random value of at least 32 bytes; empty disables recovery/OIDC.
WORKBENCH_AUTH_SECRET=
WORKBENCH_SMTP_HOST=
WORKBENCH_SMTP_PORT=587
WORKBENCH_SMTP_SENDER=
WORKBENCH_SMTP_USERNAME=
WORKBENCH_SMTP_PASSWORD=
WORKBENCH_SMTP_TLS=starttls
WORKBENCH_GOOGLE_ENABLED=false
WORKBENCH_GOOGLE_CLIENT_ID=
WORKBENCH_GOOGLE_CLIENT_SECRET=
WORKBENCH_GOOGLE_CALLBACK_URL=
WORKBENCH_AUTH_FRONTEND_ORIGIN=
